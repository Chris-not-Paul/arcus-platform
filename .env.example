ARCUS_API_PORT=4174
# Optional absolute path when private data is stored outside the application directory.
# ARCUS_PRIVATE_DATA_DIR=C:\secure\arcus-private-data
# Optional absolute path for operational backups. Keep it outside the repo in production.
# ARCUS_BACKUP_DIR=C:\secure\arcus-backups
ARCUS_BACKUP_RETENTION_DAYS=30
ARCUS_BACKUP_RETENTION_COUNT=20
ARCUS_BACKUP_FRESHNESS_MAX_AGE_HOURS=26
ARCUS_PROFESSIONAL_USERNAME=arcus
ARCUS_PROFESSIONAL_PASSWORD=change-me
ARCUS_SESSION_MAX_AGE_SECONDS=28800
ARCUS_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
ARCUS_LOGIN_RATE_LIMIT_WINDOW_MS=300000
ARCUS_LOGIN_RATE_LIMIT_LOCK_MS=900000
ARCUS_APP_BASE_URL=http://127.0.0.1:5173
ARCUS_EMAIL_FROM=ARCUS <no-reply@arcus.local>
# Local development writes transactional emails to private-data/auth/email-outbox.json.
# Use "webhook" in staging/production to POST transactional emails to an email adapter/provider.
ARCUS_EMAIL_TRANSPORT=outbox
# ARCUS_EMAIL_WEBHOOK_URL=https://email-adapter.example.com/arcus/email
# ARCUS_EMAIL_WEBHOOK_API_KEY=change-me
ARCUS_EMAIL_WEBHOOK_TIMEOUT_MS=8000
ARCUS_PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Professional exports are server-generated and capped per request.
# Keep this value at 25 unless a contractual data-access policy says otherwise.
ARCUS_PROFESSIONAL_EXPORT_MAX_EVENTS=25
# PostgreSQL is optional in local development and required for production persistence.
# ARCUS_DATABASE_URL=postgresql://arcus:change-me@127.0.0.1:5432/arcus
# Run npm run test:backend:postgres with ARCUS_DATABASE_URL set to validate DB-backed auth, audit and exports.
ARCUS_DATABASE_SSL=false
ARCUS_DEFAULT_ORGANIZATION_SLUG=arcus-local
ARCUS_DEFAULT_ORGANIZATION_NAME=ARCUS Local
# Optional ISO date, for example 2026-12-31T23:59:59Z
ARCUS_DEFAULT_ORGANIZATION_PLAN_RENEWS_AT=
# Comma-separated origins in production, e.g. https://app.arcus.example
ARCUS_ALLOWED_ORIGINS=
# Set to true behind HTTPS in production.
ARCUS_COOKIE_SECURE=false
# Emits one compact JSON access log per API request when enabled.
ARCUS_ACCESS_LOGS=false
