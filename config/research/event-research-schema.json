{
  "schema_version": "arcus-event-research-schema-v1",
  "purpose": "Controlled research enrichment for documented bridge-collapse records. It separates pre-event characteristics, event observations and post-event consequences without converting missing or inferred information into facts.",
  "missing_value_states": [
    "not_assessed",
    "not_found",
    "not_applicable",
    "conflicting_sources",
    "withheld"
  ],
  "evidence_states": [
    "documented",
    "reported",
    "inferred_reviewed",
    "inferred_unreviewed",
    "unknown"
  ],
  "visibility_levels": {
    "O1": "Public event data approved for the Open release",
    "R1": "Controlled Research data",
    "P1": "Professional project output",
    "I1": "Internal editorial evidence"
  },
  "rules": [
    "Every value must retain event identity, temporal phase and evidence state.",
    "Inferred values must never be displayed or exported as documented facts.",
    "Post-event information is excluded from pre-event matching and predictive experiments.",
    "Fields with insufficient coverage remain nullable and are not imputed.",
    "Episode membership is an independence control, not proof of common causation.",
    "A field may enter production learning only after a separate value audit and versioned approval."
  ],
  "fields": [
    {
      "key": "location_precision",
      "group": "record_precision",
      "phase": "record_metadata",
      "type": "controlled_string",
      "source": "EVENTS.location_precision",
      "visibility": "O1",
      "atlas_use": "sources_and_quality",
      "analytics_use": "filter_and_completeness",
      "learning_use": "quality_control_only"
    },
    {
      "key": "coordinate_source_url",
      "group": "record_precision",
      "phase": "record_metadata",
      "type": "url",
      "source": "EVENTS.coordinate_source_url",
      "visibility": "O1_after_source_review",
      "atlas_use": "sources_and_quality",
      "analytics_use": "none",
      "learning_use": "excluded"
    },
    {
      "key": "coordinate_uncertainty_m",
      "group": "record_precision",
      "phase": "record_metadata",
      "type": "non_negative_number",
      "source": "research_extension",
      "visibility": "R1",
      "atlas_use": "dossier",
      "analytics_use": "filter_and_sensitivity",
      "learning_use": "quality_control_only"
    },
    {
      "key": "event_date_precision",
      "group": "record_precision",
      "phase": "record_metadata",
      "type": "enum",
      "allowed_values": ["day", "month", "year", "range", "unknown"],
      "source": "research_extension",
      "visibility": "O1",
      "atlas_use": "sources_and_quality",
      "analytics_use": "filter_and_completeness",
      "learning_use": "quality_control_only"
    },
    {
      "key": "episode_id",
      "group": "event_episode",
      "phase": "event",
      "type": "stable_identifier",
      "source": "curated_or_versioned_episode_registry",
      "visibility": "R1",
      "atlas_use": "hidden",
      "analytics_use": "independence_control",
      "learning_use": "grouped_holdout_control"
    },
    {
      "key": "episode_assignment_status",
      "group": "event_episode",
      "phase": "event",
      "type": "controlled_string",
      "source": "curated_or_versioned_episode_registry",
      "visibility": "R1",
      "atlas_use": "hidden",
      "analytics_use": "sensitivity_and_review",
      "learning_use": "grouped_holdout_control"
    },
    {
      "key": "span_configuration",
      "group": "bridge_configuration",
      "phase": "pre_event",
      "type": "enum",
      "allowed_values": ["single_span", "multi_span", "unknown"],
      "source": "research_extension",
      "visibility": "R1",
      "atlas_use": "bridge_dossier",
      "analytics_use": "filter_and_comparison",
      "learning_use": "candidate_feature"
    },
    {
      "key": "span_count",
